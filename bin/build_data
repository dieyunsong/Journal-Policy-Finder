#!/usr/bin/env ruby

# Builds html/data.json for the Northwestern Journal Policy Finder from a local,
# version-controlled CSV (data/northwestern-agreements.csv).
#
# Each journal row carries links to the publisher's open access, embargo/
# sharing, and APC policy pages, plus the journal's own website. The output
# shape is what the front-end (html/js/script.js) expects:
#
#   { "header": [...9 columns...], "version": "...", "data": [ [ ...9 cells... ], ... ] }
#
# Each row is a positional array of 9 strings; empty cells become null. Only
# eISSN, eISSN Link, Journal Website, and Notes may be blank - the three policy
# link columns are required (a journal with no known policy link is not listed).
#
# Usage: ruby bin/build_data        (run from the repo root)

require "csv"
require "json"
require "digest"

CSV_FILE  = File.join(__dir__, "..", "data", "northwestern-agreements.csv")
JSON_FILE = File.join(__dir__, "..", "html", "data.json")

HEADER = [
  "Publisher",
  "Journal Title",
  "eISSN",
  "eISSN Link",
  "Journal Website",
  "Open Access Options",
  "Embargo & Sharing Policy",
  "APC Information",
  "Notes",
]

# Columns that are allowed to be blank/null in the output.
NULL_ALLOWED = ["eISSN", "eISSN Link", "Journal Website", "Notes"]

def abort_with(message)
  warn "build_data: #{message}"
  exit 1
end

rows = CSV.read(CSV_FILE, headers: true, encoding: "UTF-8")

# Validate the header matches exactly (order included).
unless rows.headers == HEADER
  abort_with("CSV header mismatch.\n  expected: #{HEADER.inspect}\n  got:      #{rows.headers.inspect}")
end

data = []
rows.each_with_index do |row, i|
  cells = HEADER.map { |col| v = row[col]; v.nil? || v.strip.empty? ? nil : v.strip }

  # Required columns must be present.
  HEADER.each_with_index do |col, idx|
    next if NULL_ALLOWED.include?(col)
    if cells[idx].nil?
      abort_with("row #{i + 2}: required column '#{col}' is blank")
    end
  end

  data << cells
end

abort_with("no data rows found in #{CSV_FILE}") if data.empty?

# Version is a short content hash of the data so the build is deterministic:
# it changes only when the data changes, not with the date the build runs.
output = {
  "header"  => HEADER,
  "version" => Digest::SHA256.hexdigest(JSON.generate(data))[0, 12],
  "data"    => data,
}

File.write(JSON_FILE, JSON.generate(output))
puts "build_data: wrote #{data.length} rows to #{File.expand_path(JSON_FILE)}"
